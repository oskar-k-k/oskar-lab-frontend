{
  "openapi": "3.0.3",
  "info": {
    "title": "Oskar Lab browser APIs",
    "version": "1.0.0"
  },
  "paths": {
    "/api/try-on": {
      "get": {
        "operationId": "tryOnStatus",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "online",
                    "configured"
                  ],
                  "properties": {
                    "online": {
                      "type": "boolean"
                    },
                    "configured": {
                      "type": "boolean"
                    },
                    "engine": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "tryOn",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "person",
                  "garment"
                ],
                "properties": {
                  "person": {
                    "type": "string",
                    "format": "binary"
                  },
                  "garment": {
                    "type": "string",
                    "format": "binary"
                  },
                  "category": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generated image or compatible worker JSON",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "imageUrl": {
                      "type": "string"
                    },
                    "imageBase64": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "operationId": "platformSession",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "nullable": true,
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/PlatformIdentity"
                    },
                    "sessionUnavailable": {
                      "type": "boolean"
                    },
                    "expires": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "operationId": "registerAccount",
        "description": "Requires a same-origin request and JSON content type.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "authjs.session-token",
        "description": "Managed by Auth.js; secure deployments use the __Secure- cookie prefix."
      }
    }
  }
}
