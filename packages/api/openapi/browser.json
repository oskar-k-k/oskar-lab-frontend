            "$ref": "#/components/schemas/SortObject"
          },
          "unpaged": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "PageAppEntity": {
        "properties": {
          "content": {
            "items": {
              "$ref": "#/components/schemas/AppEntity"
            },
            "type": "array"
          },
          "empty": {
            "type": "boolean"
          },
          "first": {
            "type": "boolean"
          },
          "last": {
            "type": "boolean"
          },
          "number": {
            "format": "int32",
            "type": "integer"
          },
          "numberOfElements": {
            "format": "int32",
            "type": "integer"
          },
          "pageable": {
            "$ref": "#/components/schemas/PageableObject"
          },
          "size": {
            "format": "int32",
            "type": "integer"
          },
          "sort": {
            "$ref": "#/components/schemas/SortObject"
          },
          "totalElements": {
            "format": "int64",
            "type": "integer"
          },
          "totalPages": {
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "content",
          "empty",
          "first",
          "last",
          "number",
          "numberOfElements",
          "pageable",
          "size",
          "sort",
          "totalElements",
          "totalPages"
        ],
        "type": "object"
      },
      "Plan": {
