          },
          "trackingMode": {
            "enum": [
              "reps",
              "seconds",
              "weighted"
            ],
            "type": "string"
          }
        },
        "required": [
          "exerciseId",
          "id",
          "recordedAt",
          "sets",
          "trackingMode"
        ],
        "type": "object"
      },
      "Login": {
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/PlatformIdentity"
          }
        },
        "required": [
          "token",
          "user"
        ],
        "type": "object"
      },
      "Logout": {
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
