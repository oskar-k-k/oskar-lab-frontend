  "info": {
    "title": "Oskar Lab browser APIs",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/auth/register": {
      "post": {
        "description": "Requires a same-origin request and JSON content type.",
        "operationId": "registerAccount",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "operationId": "platformSession",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "nullable": true,
                  "properties": {
                    "expires": {
                      "type": "string"
                    },
                    "sessionUnavailable": {
                      "type": "boolean"
                    },
                    "user": {
                      "$ref": "#/components/schemas/PlatformIdentity"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        }
      }
    },
    "/api/try-on": {
      "get": {
        "operationId": "tryOnStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "configured": {
                      "type": "boolean"
                    },
                    "engine": {
                      "type": "string"
                    },
                    "online": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "online",
                    "configured"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        }
      },
      "post": {
        "operationId": "tryOn",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "category": {
                    "type": "string"
                  },
                  "garment": {
                    "format": "binary",
                    "type": "string"
                  },
                  "person": {
                    "format": "binary",
                    "type": "string"
                  }
                },
                "required": [
                  "person",
                  "garment"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "imageBase64": {
                      "type": "string"
                    },
                    "imageUrl": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "image/png": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Generated image or compatible worker JSON"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        }
      }
    },
