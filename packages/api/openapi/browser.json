      },
      "LinkRequired": {
        "properties": {
          "linkRequired": {
            "type": "boolean"
          }
        },
        "required": [
          "linkRequired"
        ],
        "type": "object"
      },
      "ListRequest": {
        "properties": {
          "page": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "pageSize": {
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "page",
          "pageSize"
        ],
        "type": "object"
      },
      "Log": {
        "properties": {
          "exerciseId": {
            "format": "uuid",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
