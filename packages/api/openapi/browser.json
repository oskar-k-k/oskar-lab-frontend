{
  "components": {
    "schemas": {
      "AppEntity": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "path": {
            "type": "string"
          },
          "title": {
            "nullable": true,
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "createdAt",
          "description",
          "id",
          "path",
          "title",
          "updatedAt"
        ],
        "type": "object"
      },
      "Entry": {
        "properties": {
          "exerciseId": {
            "format": "uuid",
            "type": "string"
          },
          "mode": {
            "enum": [
              "reps",
              "seconds",
              "unspecified"
            ],
            "pattern": "reps|seconds|unspecified",
            "type": "string"
          },
          "notes": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string"
          },
          "restMax": {
            "format": "int32",
            "maximum": 86400,
            "minimum": 0,
            "nullable": true,
            "type": "integer"
          },
          "restMin": {
            "format": "int32",
            "maximum": 86400,
            "minimum": 0,
            "nullable": true,
            "type": "integer"
          },
          "setsMax": {
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "setsMin": {
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "superset": {
            "maxLength": 32,
            "minLength": 0,
            "type": "string"
          },
          "targetMax": {
            "format": "int32",
            "maximum": 86400,
            "minimum": 1,
            "nullable": true,
            "type": "integer"
          },
          "targetMin": {
            "format": "int32",
            "maximum": 86400,
            "minimum": 1,
            "nullable": true,
            "type": "integer"
          },
          "trackingMode": {
            "enum": [
              "reps",
              "seconds",
              "weighted"
            ],
            "pattern": "reps|seconds|weighted",
            "type": "string"
          }
        },
        "required": [
          "exerciseId",
          "mode",
          "notes",
          "restMax",
          "restMin",
          "setsMax",
          "setsMin",
          "superset",
          "targetMax",
          "targetMin"
        ],
        "type": "object"
      },
      "ExerciseDto": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "nameDe": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "nameDe"
        ],
        "type": "object"
      },
      "History": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/Log"
            },
            "type": "array"
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": [
